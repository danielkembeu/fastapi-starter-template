# ═══════════════════════════════════════════════════════════════════════════════════════════
# Copier vers .env.local pour développer :   cp .env.example .env.local
#
# Règles :
#   • En staging/production, ces variables sont INJECTÉES par l'orchestrateur (Docker, GitHub
#     Actions, plateforme d'hébergement) : aucun fichier de secrets n'est déposé sur un serveur ni
#     embarqué dans une image.
#   • Une variable d'environnement réelle l'emporte toujours sur ce fichier.
#   • L'application REFUSE DE DÉMARRER si une variable requise manque ou si un réglage est dangereux
#     pour l'environnement (voir docs/ENVIRONNEMENTS.md). Le message liste tous les problèmes.
#   • Ne jamais committer un vrai fichier .env* (seul .env.example est suivi par git).
# ═══════════════════════════════════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────────────────────────────────
# local | ci | staging | production   (défaut : local)
ENVIRONMENT=local
APP_NAME=FastAPI Backend Template
APP_VERSION=1.0.0
APP_HOST=127.0.0.1
APP_PORT=8000
# URL publique du service (liens dans les e-mails, URLs de fichiers). Vide = non utilisée.
APP_PUBLIC_URL=
# Version de l'API : toutes les routes métier sont sous /api/<version> (v1, v2…). Sondes /health non versionnées.
API_VERSION=v1
# Inscription ouverte à tous. false = les comptes sont créés autrement (make create-admin, import…).
REGISTRATION_ENABLED=true

# ── Logs et erreurs ────────────────────────────────────────────────────────────────────────
# Niveau minimal : DEBUG | INFO | WARNING | ERROR | CRITICAL. Vide = DEBUG en local, INFO ailleurs.
LOG_LEVEL=
# auto (texte lisible en local/ci, JSON en staging/production) | text | json
LOG_FORMAT=auto
# Traces d'appels dans les LOGS. Vide = oui partout sauf en production (Sentry les porte).
LOG_STACKTRACES=
# Détail technique (type d'exception, trace) dans la RÉPONSE au client. Vide = oui en local/ci, jamais en
# staging/production. true est REFUSÉ en production.
ERROR_DEBUG=

# ── Base de données ────────────────────────────────────────────────────────────────────────
# postgres (SQLModel + Alembic, défaut) | mongodb (voir docs/BASES_DE_DONNEES.md)
DATABASE_BACKEND=postgres

# PostgreSQL — en local : une base LOCALE (make up). L'application refuse de démarrer sur une base
# distante (verrou de sécurité). Pour passer outre sciemment : ALLOW_REMOTE_DB_IN_LOCAL=true
DATABASE_URL=postgresql://postgres:pw@127.0.0.1:55432/app_dev
ALLOW_REMOTE_DB_IN_LOCAL=false
# Pool par worker. Règle : WEB_CONCURRENCY × (DB_POOL_SIZE + DB_MAX_OVERFLOW) < max_connections de PostgreSQL.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# MongoDB — requis seulement avec DATABASE_BACKEND=mongodb (pip install -r requirements-mongo.txt)
MONGODB_URL=
MONGODB_DB_NAME=
MONGODB_TIMEOUT_MS=2000

# ── Authentification ───────────────────────────────────────────────────────────────────────
# Obligatoire. En staging/production : au moins 32 caractères aléatoires, jamais une valeur d'exemple.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_JWT=
JWT_ALGORITHM=HS256
# Le jeton d'accès n'est pas révocable avant expiration : le garder COURT.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Verrouillage de compte après N échecs consécutifs, pendant M minutes.
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Sessions simultanées par compte ; au-delà, la plus ancienne est supprimée.
MAX_SESSIONS_PER_USER=2
BCRYPT_ROUNDS=12

# ── Réseau et sécurité HTTP ────────────────────────────────────────────────────────────────
# Origines web autorisées par CORS, séparées par des virgules. JAMAIS "*" ; pas de localhost en production.
CORS_ORIGINS=http://localhost:3000
# Staging : identifiants HTTP Basic pour accéder à /docs (fermé en production, ouvert en local).
DOCS_USERNAME=
DOCS_PASSWORD=
# Reverse proxy de confiance (IP lues dans X-Forwarded-For). Lu par le Dockerfile.
FORWARDED_ALLOW_IPS=127.0.0.1
# Nombre de workers uvicorn (≈ 1 par cœur dédié à l'API). Lu par le Dockerfile.
WEB_CONCURRENCY=2

# ── Redis et limitation de débit ───────────────────────────────────────────────────────────
# Redis (cache, files). Vide = non utilisé.
REDIS_URL=
RATE_LIMIT_ENABLED=true
# memory:// = compteur PAR PROCESSUS (développement). En production avec plusieurs workers : redis://…
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_REGISTER=20/hour
RATE_LIMIT_SENSITIVE=10/minute

# ── E-mail ─────────────────────────────────────────────────────────────────────────────────
# console (journalise, développement) | smtp (envoi réel) | disabled (le projet n'envoie aucun e-mail)
# console est REFUSÉ en staging/production.
EMAIL_BACKEND=console
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS (port 587) ou TLS implicite (port 465) : exclusifs.
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

# ── Stockage de fichiers ───────────────────────────────────────────────────────────────────
# disabled | local (disque, développement seulement) | cloudinary | s3 (pip install -r requirements-storage.txt)
# local est REFUSÉ en staging/production (le disque d'un conteneur est perdu à chaque déploiement).
STORAGE_BACKEND=disabled
UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp
# local
STORAGE_LOCAL_PATH=static/uploads
STORAGE_LOCAL_PUBLIC_URL=http://localhost:8000/static/uploads
# cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# s3 — AWS, ou tout stockage compatible (MinIO, Scaleway, Cloudflare R2…) via S3_ENDPOINT_URL
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ── Supervision ────────────────────────────────────────────────────────────────────────────
# Vide = Sentry désactivé.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# En-tête X-Health-Token donnant le détail de /health/ready (sinon : seulement « ok » ou « down »).
HEALTH_DETAIL_TOKEN=

# ── Services de développement (docker-compose.yml) ────────────────────────────────────────
# Ports publiés sur 127.0.0.1 par `make up`. Changer ici si un port est déjà pris sur votre poste.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=pw
POSTGRES_DB=app_dev
POSTGRES_PORT=55432
REDIS_PORT=56379
MONGO_PORT=57017
SMTP_DEV_PORT=51025
MAIL_UI_PORT=58025
MINIO_PORT=59000
MINIO_CONSOLE_PORT=59001
